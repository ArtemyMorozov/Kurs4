namespace TokenizerApp
{
    public enum TokenType
    {
        KEYWORD_IF,
        KEYWORD_ELSE,
        KEYWORD_THEN,
        IDENTIFIER,
        HEX_NUMBER,
        DECIMAL_NUMBER,
        ASSIGNMENT,
        COMPARISON,
        SEMICOLON,
        LEFT_PARENTHESIS,
        RIGHT_PARENTHESIS,
        PLUS,
        MINUS,
        MULTIPLY,
        ERROR,
        UNKNOWN
    }

    public struct Token
    {
        public string Value;
        public TokenType Type;
        public int LineNumber;

        public Token(string value, TokenType type, int lineNumber)
        {
            Value = value;
            Type = type;
            LineNumber = lineNumber;
        }
    }

